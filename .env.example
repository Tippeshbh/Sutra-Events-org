# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sutra Events Configuration
# Admin authentication password (hashed with bcrypt on init if custom)
ADMIN_PASSWORD="sutra_admin_davangere"
ADMIN_SESSION_SECRET="sutra_jwt_super_secret_key_davangere_2026"

# Notification Provider Integrations (Optional credentials)
# Notifications are clearly reported with provider status
NOTIFICATION_EMAIL_ENABLED="false"
NOTIFICATION_WHATSAPP_ENABLED="false"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Supabase Integration
SUPABASE_PROJECT_ID="hfopeubspzlxoyrljjtc"
SUPABASE_URL="https://hfopeubspzlxoyrljjtc.supabase.co"
